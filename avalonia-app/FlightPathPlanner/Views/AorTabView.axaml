<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlightPathPlanner.ViewModels"
             xmlns:controls="using:FlightPathPlanner.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="344"
             x:Class="FlightPathPlanner.Views.AorTabView"
             SizeChanged="Root_SizeChanged"
             x:DataType="vm:AorTabViewModel">

  <DockPanel>

    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,12" IsVisible="{Binding HasAors}">
      <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource LunaAccentTintBrush}">
        <controls:LunaIcon Classes="accent" Data="{StaticResource IconFile}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding UploadedFileName}" Classes="cardtitle" />
        <TextBlock Text="AoR data" Classes="meta" />
      </StackPanel>
      <Button Grid.Column="2" Content="Replace" Classes="small" Click="UploadButton_Click" VerticalAlignment="Center"
              AutomationProperties.Name="Upload a different AoR JSON file" />
    </Grid>

    <Border DockPanel.Dock="Top" Classes="card quiet" Margin="0,0,0,12" IsVisible="{Binding IsBusy}">
      <StackPanel Spacing="8">
        <TextBlock Text="{Binding BusyText}" Classes="secondary" />
        <ProgressBar IsIndeterminate="True" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Top" Classes="card quiet" Margin="0,0,0,12" BorderBrush="#40FBBF24"
            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <controls:LunaIcon Classes="warning" Data="{StaticResource IconAlert}" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Classes="secondary" TextWrapping="Wrap" />
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Classes="card quiet" Margin="0,10,0,0" IsVisible="{Binding HasSelection}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="TOTAL SELECTED AREA" Classes="overline" />
            <TextBlock Text="{Binding TotalSelectedAreaDisplay}" FontSize="16" FontWeight="SemiBold" />
          </StackPanel>
          <Border Grid.Column="1" Classes="pill accent" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectAllLabel}" />
          </Border>
        </Grid>
        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
          <Button HorizontalAlignment="Stretch" Click="ExportJsonButton_Click" AutomationProperties.Name="Export selection as JSON">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:LunaIcon Classes="small" Data="{StaticResource IconDownload}" />
              <TextBlock Text="JSON" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="ExportXlsxButton_Click" AutomationProperties.Name="Export selection as XLSX">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:LunaIcon Classes="small" Data="{StaticResource IconDownload}" />
              <TextBlock Text="XLSX" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="danger" Command="{Binding DeleteSelectedCommand}" Width="40" Padding="0"
                  AutomationProperties.Name="Delete selected" ToolTip.Tip="Remove selected from this session">
            <controls:LunaIcon Data="{StaticResource IconTrash}" />
          </Button>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Details (inspector): IsVisible on the outer element, DataContext override on the inner one. -->
    <Border DockPanel.Dock="Bottom" IsVisible="{Binding ActiveAor, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border x:Name="InspectorCard" Classes="card" Margin="0,10,0,0" Padding="0" MaxHeight="270" DataContext="{Binding ActiveAor}">
        <ScrollViewer x:DataType="vm:AorRowViewModel" Padding="0,0,10,0">
          <StackPanel Margin="16,14,6,16" Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="AREA DETAILS" Classes="overline" />
                <TextBlock Text="{Binding Name}" Classes="section" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding Designator}" Classes="meta mono" Margin="0,2,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Classes="icon ghost" VerticalAlignment="Top" Click="CloseDetailsButton_Click"
                      AutomationProperties.Name="Close details">
                <controls:LunaIcon Data="{StaticResource IconX}" />
              </Button>
            </Grid>
            <Border Classes="divider" />

            <WrapPanel IsVisible="{Binding HasRestriction}">
              <Border Classes="pill danger" IsVisible="{Binding IsProhibited}"><TextBlock Text="{Binding RestrictionDisplay}" /></Border>
              <Border Classes="pill success" IsVisible="{Binding IsNoRestriction}"><TextBlock Text="{Binding RestrictionDisplay}" /></Border>
              <Border Classes="pill warning" IsVisible="{Binding IsConditionalRestriction}"><TextBlock Text="{Binding RestrictionDisplay}" /></Border>
            </WrapPanel>

            <Border Classes="card quiet" IsVisible="{Binding HasMessage}">
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <controls:LunaIcon Classes="warning" Data="{StaticResource IconAlert}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" Classes="body" TextWrapping="Wrap" />
              </Grid>
            </Border>

            <StackPanel Spacing="6">
              <TextBlock Text="GEOMETRY" Classes="overline" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Area" Classes="secondary" />
                <TextBlock Grid.Column="1" Text="{Binding AreaDisplay}" Classes="body" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasApplicability}">
              <TextBlock Text="APPLICABILITY (UTC)" Classes="overline" />
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasEffectiveTimeBegin}">
                <TextBlock Text="Start" Classes="secondary" />
                <TextBlock Grid.Column="1" Text="{Binding EffectiveTimeBeginDisplay}" Classes="body mono" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasEffectiveTimeEnd}">
                <TextBlock Text="End" Classes="secondary" />
                <TextBlock Grid.Column="1" Text="{Binding EffectiveTimeEndDisplay}" Classes="body mono" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="VERTICAL LIMITS" Classes="overline" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Lower limit" Classes="secondary" />
                <TextBlock Grid.Column="1" Text="{Binding LowerLimitDisplay}" Classes="body" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Upper limit" Classes="secondary" />
                <TextBlock Grid.Column="1" Text="{Binding UpperLimitDisplay}" Classes="body" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Reference" Classes="secondary" />
                <TextBlock Grid.Column="1" Text="{Binding VerticalReferenceType}" Classes="body" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasAutoReject}">
              <TextBlock Text="SETTINGS" Classes="overline" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Auto-reject flights" Classes="secondary" VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="pill accent"><TextBlock Text="{Binding AutoRejectDisplay}" /></Border>
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

    <!-- Empty state -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="260" IsVisible="{Binding !HasAors}">
      <Border Width="60" Height="60" CornerRadius="20" Background="{DynamicResource LunaAccentTintBrush}" HorizontalAlignment="Center">
        <controls:LunaIcon Classes="accent large" Data="{StaticResource IconShield}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="No AoRs loaded" Classes="section" HorizontalAlignment="Center" Margin="0,6,0,0" />
      <TextBlock Text="Upload an AoR JSON file to begin." Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" />
      <Button Classes="primary" Click="UploadButton_Click" HorizontalAlignment="Center" Margin="0,8,0,0" AutomationProperties.Name="Upload AoR JSON">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:LunaIcon Data="{StaticResource IconUpload}" />
          <TextBlock Text="Upload AoR JSON" />
        </StackPanel>
      </Button>
    </StackPanel>

    <ScrollViewer Padding="0,0,12,0" IsVisible="{Binding HasAors}">
      <StackPanel Spacing="14">

        <TextBox Classes="search" Watermark="Search areas..." Text="{Binding SearchQuery}" AutomationProperties.Name="Search areas">
          <TextBox.InnerLeftContent>
            <controls:LunaIcon Data="{StaticResource IconSearch}" Margin="12,0,0,0" />
          </TextBox.InnerLeftContent>
        </TextBox>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="AREAS OF RESPONSIBILITY" Classes="overline" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{Binding SelectAllLabel}" Classes="ghost small" Command="{Binding ToggleSelectAllCommand}" />
        </Grid>

        <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,16,0,0" IsVisible="{Binding HasNoFilteredAors}">
          <controls:LunaIcon Classes="large" Data="{StaticResource IconSearch}" HorizontalAlignment="Center" />
          <TextBlock Text="No areas match" Classes="cardtitle" HorizontalAlignment="Center" />
          <TextBlock Text="Try a different search." Classes="secondary" TextAlignment="Center" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding FilteredAors}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AorRowViewModel">
              <Border Classes="card interactive" Classes.selected="{Binding IsSelected}" Padding="12" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                  <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" MinWidth="0"
                            AutomationProperties.Name="Select area" />
                  <StackPanel Grid.Column="1" Spacing="4" Tag="{Binding}" Tapped="AorRow_Tapped">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                      <Ellipse Classes="dot" Fill="{Binding Color}" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="cardtitle" />
                    </Grid>
                    <TextBlock Text="{Binding Designator}" Classes="meta mono" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                      <controls:LunaIcon Classes="small" Data="{StaticResource IconLayers}" />
                      <TextBlock Text="{Binding AreaDisplay}" Classes="meta" />
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
                    <Border Classes="pill danger" HorizontalAlignment="Right" IsVisible="{Binding IsProhibited}"><TextBlock Text="Prohibited" /></Border>
                    <Border Classes="pill success" HorizontalAlignment="Right" IsVisible="{Binding IsNoRestriction}"><TextBlock Text="No restriction" /></Border>
                    <Border Classes="pill warning" HorizontalAlignment="Right" IsVisible="{Binding IsConditionalRestriction}"><TextBlock Text="{Binding RestrictionDisplay}" /></Border>
                    <Button Classes="icon compact ghost danger" Tag="{Binding}" Click="DeleteAorButton_Click" HorizontalAlignment="Right"
                            AutomationProperties.Name="Remove area" ToolTip.Tip="Remove from this session">
                      <controls:LunaIcon Classes="small" Data="{StaticResource IconX}" />
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </ScrollViewer>

  </DockPanel>

</UserControl>
