<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlightPathPlanner.ViewModels"
             xmlns:controls="using:FlightPathPlanner.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="344"
             x:Class="FlightPathPlanner.Views.ReportTabView"
             x:DataType="vm:ReportTabViewModel">

  <Grid>

    <!-- Empty state -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="260" IsVisible="{Binding !HasOpsAndAors}">
      <Border Width="60" Height="60" CornerRadius="20" Background="{DynamicResource LunaAccentTintBrush}" HorizontalAlignment="Center">
        <controls:LunaIcon Classes="accent large" Data="{StaticResource IconReport}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="No report yet" Classes="section" HorizontalAlignment="Center" Margin="0,6,0,0" />
      <TextBlock Text="{Binding MissingDataText}" Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Padding="0,0,12,0" IsVisible="{Binding HasOpsAndAors}">
      <StackPanel Spacing="14">

        <!-- Export the whole geozone report -->
        <Border Classes="card quiet">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="GEOZONE REPORT" Classes="overline" />
                <TextBlock Classes="cardtitle" Margin="0,2,0,0">
                  <Run Text="{Binding AorCount}" /><Run Text=" AoRs" />
                </TextBlock>
              </StackPanel>
              <controls:LunaIcon Grid.Column="1" Classes="accent" Data="{StaticResource IconReport}" VerticalAlignment="Top" />
            </Grid>
            <TextBlock Text="Exports a match count for every AoR against the current OPS filters." Classes="secondary" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button HorizontalAlignment="Stretch" Click="ExportJsonButton_Click" AutomationProperties.Name="Export report as JSON">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:LunaIcon Classes="small" Data="{StaticResource IconDownload}" />
                  <TextBlock Text="JSON" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="ExportXlsxButton_Click" AutomationProperties.Name="Export report as XLSX">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <controls:LunaIcon Classes="small" Data="{StaticResource IconDownload}" />
                  <TextBlock Text="XLSX" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Area of responsibility picker -->
        <StackPanel Spacing="8">
          <TextBlock Text="AREA OF RESPONSIBILITY" Classes="overline" />
          <TextBox Classes="search" Watermark="Search AoRs..." Text="{Binding AorSearchQuery}" AutomationProperties.Name="Search AoRs">
            <TextBox.InnerLeftContent>
              <controls:LunaIcon Data="{StaticResource IconSearch}" Margin="12,0,0,0" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <!-- One-way selection: the choice is written back only from user clicks (AorList_SelectionChanged),
               so filtering the list never clears the chosen AoR. -->
          <ListBox Name="AorList" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemsSource="{Binding AorOptions}" SelectedItem="{Binding SelectedAor, Mode=OneWay}"
                   MaxHeight="190" SelectionChanged="AorList_SelectionChanged" AutomationProperties.Name="Areas of responsibility">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:ReportAorOptionViewModel">
                <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>

        <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,8,0,0" IsVisible="{Binding !HasSelectedAor}">
          <controls:LunaIcon Classes="large" Data="{StaticResource IconShield}" HorizontalAlignment="Center" />
          <TextBlock Text="Select an AoR" Classes="cardtitle" HorizontalAlignment="Center" />
          <TextBlock Text="Choose one above, or click one on the map, to see the flight plans inside it." Classes="secondary"
                     TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Spacing="12" IsVisible="{Binding HasSelectedAor}">

          <!-- Dashboard card -->
          <Border Classes="card selected">
            <StackPanel Spacing="4">
              <TextBlock Text="SELECTED AoR" Classes="overline" />
              <TextBlock Text="{Binding SelectedAor.Name}" Classes="cardtitle" />
              <TextBlock Text="{Binding SelectedAor.Designator}" Classes="meta mono" />
              <TextBlock Text="{Binding MatchCount}" Classes="stat" Margin="0,8,0,0" />
              <TextBlock Text="Matching OPS" Classes="secondary" />
            </StackPanel>
          </Border>

          <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,4,0,0" IsVisible="{Binding HasNoMatches}">
            <controls:LunaIcon Classes="large" Data="{StaticResource IconSearch}" HorizontalAlignment="Center" />
            <TextBlock Text="No flight plans intersect this area" Classes="cardtitle" HorizontalAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Within the current OPS filters." Classes="secondary" HorizontalAlignment="Center" />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding MatchingOps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OpsRowViewModel">
                <Border Classes="card" Padding="12" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Ellipse Classes="dot" Fill="{Binding Color}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="cardtitle" />
                      </Grid>
                      <StackPanel Grid.Column="1">
                        <Border Classes="pill success" IsVisible="{Binding IsActiveStatus}"><TextBlock Text="Active" /></Border>
                        <Border Classes="pill warning" IsVisible="{Binding IsPendingStatus}"><TextBlock Text="Pending" /></Border>
                        <Border Classes="pill" IsVisible="{Binding IsExpiredStatus}"><TextBlock Text="Expired" /></Border>
                      </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding OperationPlanId}" Classes="meta mono" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,2,0,0">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:LunaIcon Classes="small" Data="{StaticResource IconClock}" />
                        <TextBlock Text="{Binding StartTimeDisplay}" Classes="meta" />
                      </StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <controls:LunaIcon Classes="small" Data="{StaticResource IconLayers}" />
                        <TextBlock Text="{Binding AreaDisplay}" Classes="meta" />
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </StackPanel>
    </ScrollViewer>

  </Grid>

</UserControl>
