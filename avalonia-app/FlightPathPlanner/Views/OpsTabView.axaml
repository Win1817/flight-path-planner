<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlightPathPlanner.ViewModels"
             xmlns:controls="using:FlightPathPlanner.Controls"
             xmlns:views="using:FlightPathPlanner.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="344"
             x:Class="FlightPathPlanner.Views.OpsTabView"
             SizeChanged="Root_SizeChanged"
             x:DataType="vm:OpsTabViewModel">

  <DockPanel>

    <!-- Loaded file + replace, or the empty state when nothing is loaded. -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,0,0,12"
          IsVisible="{Binding HasOps}">
      <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource LunaAccentTintBrush}">
        <controls:LunaIcon Classes="accent" Data="{StaticResource IconFile}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="{Binding UploadedFileName}" Classes="cardtitle" />
        <TextBlock Text="OPS data" Classes="meta" />
      </StackPanel>
      <Button Grid.Column="2" Content="Replace" Classes="small" Click="UploadButton_Click" IsEnabled="{Binding Import.CanStart}" VerticalAlignment="Center"
              AutomationProperties.Name="Upload a different OPS JSON file" />
    </Grid>

    <!-- Loading -->
    <!-- Large-file notice (files of about 40 MB or more), before anything is loaded -->
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,12" BorderBrush="#66A78BFA" IsVisible="{Binding HasPendingLargeSource}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <controls:LunaIcon Classes="accent" Data="{StaticResource IconInfo}" VerticalAlignment="Top" />
          <TextBlock Text="Large file detected" Classes="cardtitle" VerticalAlignment="Center" Grid.Column="1" />
        </Grid>
        <TextBlock Text="{Binding PendingLargeText}" Classes="secondary" TextWrapping="Wrap" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
          <Button Classes="primary" Content="Continue" Command="{Binding ConfirmLargeImportCommand}" HorizontalAlignment="Stretch" />
          <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelLargeImportCommand}" HorizontalAlignment="Stretch" />
        </Grid>
      </StackPanel>
    </Border>

    <views:ImportPanel DockPanel.Dock="Top" DataContext="{Binding Import}" Margin="0,0,0,12" />

    <!-- Error -->
    <Border DockPanel.Dock="Top" Classes="card quiet" Margin="0,0,0,12" BorderBrush="#40FB7185"
            IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
        <controls:LunaIcon Classes="danger" Data="{StaticResource IconAlert}" VerticalAlignment="Top" />
        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Classes="error" />
      </Grid>
    </Border>

    <!-- Footer: selection summary + export/delete -->
    <Border DockPanel.Dock="Bottom" Classes="card quiet" Margin="0,10,0,0" IsVisible="{Binding HasSelection}">
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="TOTAL SELECTED AREA" Classes="overline" />
            <TextBlock Text="{Binding TotalSelectedAreaDisplay}" FontSize="16" FontWeight="SemiBold" />
          </StackPanel>
          <Border Grid.Column="1" Classes="pill accent" VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectAllLabel}" />
          </Border>
        </Grid>
        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
          <Button HorizontalAlignment="Stretch" Click="ExportJsonButton_Click" AutomationProperties.Name="Export selection as JSON">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:LunaIcon Classes="small" Data="{StaticResource IconDownload}" />
              <TextBlock Text="JSON" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="ExportXlsxButton_Click" AutomationProperties.Name="Export selection as XLSX">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:LunaIcon Classes="small" Data="{StaticResource IconDownload}" />
              <TextBlock Text="XLSX" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="danger" Command="{Binding DeleteSelectedCommand}" Width="40" Padding="0"
                  AutomationProperties.Name="Delete selected" ToolTip.Tip="Remove selected from this session">
            <controls:LunaIcon Data="{StaticResource IconTrash}" />
          </Button>
        </Grid>
      </StackPanel>
    </Border>

    <!-- Details (inspector). IsVisible stays on the outer element (tab scope); the DataContext override to the row
         happens on the inner element only, so the two bindings never fight over their type. -->
    <Border DockPanel.Dock="Bottom" IsVisible="{Binding ActiveOp, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Border x:Name="InspectorCard" Classes="card" Margin="0,10,0,0" Padding="0" MaxHeight="270" DataContext="{Binding ActiveOp}">
        <ScrollViewer x:DataType="vm:OpsRowViewModel" Padding="0,0,10,0">
          <StackPanel Margin="16,14,6,16" Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="OPERATION DETAILS" Classes="overline" />
                <TextBlock Text="{Binding Title}" Classes="section" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Text="{Binding OperationPlanId}" Classes="meta mono" Margin="0,2,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Classes="icon ghost" VerticalAlignment="Top" Click="CloseDetailsButton_Click"
                      AutomationProperties.Name="Close details">
                <controls:LunaIcon Data="{StaticResource IconX}" />
              </Button>
            </Grid>
            <Border Classes="divider" />

            <StackPanel Spacing="4" IsVisible="{Binding HasOperator}">
              <TextBlock Text="OPERATOR" Classes="overline" />
              <TextBlock Text="{Binding Operator}" Classes="body mono" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding HasDescription}">
              <TextBlock Text="DESCRIPTION" Classes="overline" />
              <TextBlock Text="{Binding Description}" Classes="body" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="SCHEDULE (UTC)" Classes="overline" />
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="4">
                <TextBlock Text="Start" Classes="secondary" />
                <TextBlock Grid.Column="1" Text="{Binding StartTimeFullDisplay}" Classes="body mono" HorizontalAlignment="Right" />
                <TextBlock Grid.Row="1" Text="End" Classes="secondary" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EndTimeFullDisplay}" Classes="body mono" HorizontalAlignment="Right" />
              </Grid>
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding HasStatusInfo}">
              <TextBlock Text="STATUS" Classes="overline" />
              <WrapPanel>
                <Border Classes="pill info" Margin="0,0,6,6" IsVisible="{Binding HasState}">
                  <TextBlock Text="{Binding State}" />
                </Border>
                <Border Classes="pill accent" Margin="0,0,6,6" IsVisible="{Binding HasClosureReason}">
                  <TextBlock Text="{Binding ClosureReason}" />
                </Border>
              </WrapPanel>
            </StackPanel>

            <StackPanel Spacing="4" IsVisible="{Binding HasAltitudeInfo}">
              <TextBlock Text="ALTITUDE" Classes="overline" />
              <TextBlock Text="{Binding AltitudeRangeDisplay}" Classes="body" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Text="GEOMETRY" Classes="overline" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Area" Classes="secondary" />
                <TextBlock Grid.Column="1" Text="{Binding AreaDisplay}" Classes="body" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Zones" Classes="secondary" />
                <TextBlock Grid.Column="1" Text="{Binding ZonesDisplay}" Classes="body" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

    <!-- The last DockPanel child fills the panel; both states live in one Grid so the empty state centres in the whole panel,
         not in a docked strip. -->
    <Grid>
    <!-- Empty state -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" MaxWidth="260"
                IsVisible="{Binding !HasOps}">
      <Border Width="60" Height="60" CornerRadius="20" Background="{DynamicResource LunaAccentTintBrush}" HorizontalAlignment="Center">
        <controls:LunaIcon Classes="accent large" Data="{StaticResource IconPlane}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <TextBlock Text="No OPS loaded" Classes="section" HorizontalAlignment="Center" Margin="0,6,0,0" />
      <TextBlock Text="Upload an OPS JSON file to begin." Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" />
      <Button Classes="primary" Click="UploadButton_Click" IsEnabled="{Binding Import.CanStart}" HorizontalAlignment="Center" Margin="0,8,0,0" AutomationProperties.Name="Upload OPS JSON">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <controls:LunaIcon Data="{StaticResource IconUpload}" />
          <TextBlock Text="Upload OPS JSON" />
        </StackPanel>
      </Button>
    </StackPanel>

    <!-- Filters stay put; only the (virtualised) list scrolls, so thousands of operations never become thousands of visuals. -->
    <DockPanel IsVisible="{Binding HasOps}">
      <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,10">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
          <TextBox Classes="search" Watermark="Search operations..." Text="{Binding SearchQuery}" AutomationProperties.Name="Search operations">
            <TextBox.InnerLeftContent>
              <controls:LunaIcon Data="{StaticResource IconSearch}" Margin="12,0,0,0" />
            </TextBox.InnerLeftContent>
          </TextBox>
          <ToggleButton Grid.Column="1" Classes="chip" Content="Filters" IsChecked="{Binding FiltersVisible}" VerticalAlignment="Center"
                        AutomationProperties.Name="Show or hide filters" />
        </Grid>

        <StackPanel Spacing="14" IsVisible="{Binding FiltersVisible}">
          <StackPanel Spacing="8" IsVisible="{Binding HasClosureReasons}">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="CLOSURE REASON" Classes="overline" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Clear" Classes="ghost small" Command="{Binding ClearClosureReasonsCommand}"
                      AutomationProperties.Name="Clear closure reason filter" />
            </Grid>
            <ItemsControl ItemsSource="{Binding ClosureReasonChips}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ClosureReasonChipViewModel">
                  <ToggleButton Classes="chip" Content="{Binding Reason}" IsChecked="{Binding IsSelected}" Margin="0,0,6,6" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <controls:LunaIcon Classes="small" Data="{StaticResource IconCalendar}" />
              <TextBlock Text="TIMEFRAME" Classes="overline" VerticalAlignment="Center" />
            </StackPanel>
            <Grid ColumnDefinitions="40,*" ColumnSpacing="6">
              <TextBlock Text="From" Classes="secondary" VerticalAlignment="Center" />
              <DatePicker Grid.Column="1" SelectedDate="{Binding TimeframeFrom}" AutomationProperties.Name="From date" />
            </Grid>
            <Grid ColumnDefinitions="40,*" ColumnSpacing="6">
              <TextBlock Text="To" Classes="secondary" VerticalAlignment="Center" />
              <DatePicker Grid.Column="1" SelectedDate="{Binding TimeframeTo}" AutomationProperties.Name="To date" />
            </Grid>
          </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="OPERATIONS" Classes="overline" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{Binding SelectAllLabel}" Classes="ghost small" Command="{Binding ToggleSelectAllCommand}" />
        </Grid>

        <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,10,0,0" IsVisible="{Binding HasNoFilteredOps}">
          <controls:LunaIcon Classes="large" Data="{StaticResource IconSearch}" HorizontalAlignment="Center" />
          <TextBlock Text="No operations match" Classes="cardtitle" HorizontalAlignment="Center" />
          <TextBlock Text="Try a different search, closure reason or date range." Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </StackPanel>

      <ListBox Classes="cards" ItemsSource="{Binding FilteredOps}" AutomationProperties.Name="Operations">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:OpsRowViewModel">
            <Border Classes="card interactive" Classes.selected="{Binding IsSelected}" Padding="12" Margin="0,0,10,8">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" MinWidth="0"
                          AutomationProperties.Name="Select operation" />
                <StackPanel Grid.Column="1" Spacing="4" Tag="{Binding}" Tapped="OpRow_Tapped">
                  <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Ellipse Classes="dot" Fill="{Binding Color}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="cardtitle" />
                  </Grid>
                  <TextBlock Text="{Binding OperationPlanId}" Classes="meta mono" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Description}" Classes="secondary" MaxLines="2" TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis" IsVisible="{Binding HasDescription}" />
                  <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="14" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <controls:LunaIcon Classes="small" Data="{StaticResource IconClock}" />
                      <TextBlock Text="{Binding StartTimeDisplay}" Classes="meta" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                      <controls:LunaIcon Classes="small" Data="{StaticResource IconLayers}" />
                      <TextBlock Text="{Binding AreaDisplay}" Classes="meta" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="6" HorizontalAlignment="Right">
                  <Border Classes="pill success" HorizontalAlignment="Right" IsVisible="{Binding IsActiveStatus}"><TextBlock Text="Active" /></Border>
                  <Border Classes="pill warning" HorizontalAlignment="Right" IsVisible="{Binding IsPendingStatus}"><TextBlock Text="Pending" /></Border>
                  <Border Classes="pill" HorizontalAlignment="Right" IsVisible="{Binding IsExpiredStatus}"><TextBlock Text="Expired" /></Border>
                  <Button Classes="icon compact ghost danger" Tag="{Binding}" Click="DeleteOpButton_Click" HorizontalAlignment="Right"
                          AutomationProperties.Name="Remove operation" ToolTip.Tip="Remove from this session">
                    <controls:LunaIcon Classes="small" Data="{StaticResource IconX}" />
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
    </Grid>

  </DockPanel>

</UserControl>
