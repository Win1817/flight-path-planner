<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FlightPathPlanner.ViewModels"
        xmlns:views="using:FlightPathPlanner.Views"
        xmlns:controls="using:FlightPathPlanner.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="860"
        x:Class="FlightPathPlanner.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="UAS Tool"
        Width="1440" Height="860" MinWidth="1100" MinHeight="660"
        Background="{DynamicResource LunaBackgroundBrush}"
        Foreground="{DynamicResource LunaTextBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Panel>
        <!-- Layered backdrop: two very quiet radial glows over the near-black base. -->
        <Border Background="{DynamicResource LunaGlowTopLeft}" IsHitTestVisible="False" />
        <Border Background="{DynamicResource LunaGlowBottomRight}" IsHitTestVisible="False" />

        <Grid RowDefinitions="64,*">

            <!-- ============ Header ============ -->
            <Border Grid.Row="0" Background="#99110F19" BorderBrush="{DynamicResource LunaHairlineBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="224,*,Auto">

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource LunaAccentGradient}"
                                BoxShadow="{DynamicResource LunaGlowButton}">
                            <controls:LunaIcon Data="{StaticResource IconPlane}" Width="18" Height="18" Stroke="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="0">
                            <TextBlock Text="UAS Tool" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource LunaTextBrush}" />
                            <TextBlock Text="UAV Flight Plan Viewer" Classes="meta" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0" Spacing="1">
                        <TextBlock Text="{Binding SectionTitle}" Classes="section" />
                        <TextBlock Text="{Binding SectionSubtitle}" Classes="secondary" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center">
                        <Border Classes="pill accent" IsVisible="{Binding OpsTab.HasOps}">
                            <TextBlock Text="{Binding OpsPillText}" />
                        </Border>
                        <Border Classes="pill accent" IsVisible="{Binding AorTab.HasAors}">
                            <TextBlock Text="{Binding AorPillText}" />
                        </Border>
                        <Border Classes="pill" IsVisible="{Binding !HasAnyData}">
                            <TextBlock Text="No data loaded" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Body ============ -->
            <Grid Grid.Row="1" ColumnDefinitions="212,372,*">

                <!-- Navigation rail -->
                <Border Grid.Column="0" Classes="glass" Margin="12,12,0,12" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Spacing="4">
                            <TextBlock Text="WORKSPACE" Classes="overline" Margin="12,6,0,6" />

                            <Button Classes="nav" Classes.active="{Binding IsOpsActive}" Command="{Binding SelectTabCommand}"
                                    CommandParameter="{x:Static vm:AppTab.Ops}" AutomationProperties.Name="Operations">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <controls:LunaIcon Data="{StaticResource IconPlane}" />
                                    <TextBlock Grid.Column="1" Text="OPS" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Classes="badge" VerticalAlignment="Center" IsVisible="{Binding HasOpsBadge}">
                                        <TextBlock Text="{Binding OpsBadge}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Classes="nav" Classes.active="{Binding IsAorsActive}" Command="{Binding SelectTabCommand}"
                                    CommandParameter="{x:Static vm:AppTab.Aors}" AutomationProperties.Name="Areas of responsibility">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <controls:LunaIcon Data="{StaticResource IconShield}" />
                                    <TextBlock Grid.Column="1" Text="AoRs" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Classes="badge" VerticalAlignment="Center" IsVisible="{Binding HasAorBadge}">
                                        <TextBlock Text="{Binding AorBadge}" />
                                    </Border>
                                </Grid>
                            </Button>

                            <Button Classes="nav" Classes.active="{Binding IsReportActive}" Command="{Binding SelectTabCommand}"
                                    CommandParameter="{x:Static vm:AppTab.Report}" AutomationProperties.Name="Report">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <controls:LunaIcon Data="{StaticResource IconReport}" />
                                    <TextBlock Grid.Column="1" Text="Report" FontWeight="Medium" VerticalAlignment="Center" />
                                </Grid>
                            </Button>

                            <Button Classes="nav" Classes.active="{Binding IsLookupActive}" Command="{Binding SelectTabCommand}"
                                    CommandParameter="{x:Static vm:AppTab.Lookup}" AutomationProperties.Name="Flight lookup">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <controls:LunaIcon Data="{StaticResource IconCrosshair}" />
                                    <TextBlock Grid.Column="1" Text="Lookup" FontWeight="Medium" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Spacing="4">
                            <Border Classes="divider" Margin="8,0,8,10" />
                            <TextBlock Text="LIBRARY" Classes="overline" Margin="12,0,0,6" />
                            <Button Classes="nav" Classes.active="{Binding IsSavedActive}" Command="{Binding SelectTabCommand}"
                                    CommandParameter="{x:Static vm:AppTab.Saved}" AutomationProperties.Name="Saved locally">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <controls:LunaIcon Data="{StaticResource IconFolder}" />
                                    <TextBlock Grid.Column="1" Text="Saved Locally" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Classes="badge" VerticalAlignment="Center" IsVisible="{Binding HasSavedBadge}">
                                        <TextBlock Text="{Binding SavedBadge}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Tab content. Pages stay alive (their lists are expensive to rebuild) and cross-fade by opacity.
                     IsVisible/opacity live on the outer ContentControl (MainViewModel scope); the DataContext switch
                     to the tab view model happens inside the template. -->
                <Border Grid.Column="1" Classes="glass" Margin="12,12,0,12" Padding="14">
                    <Panel>
                        <ContentControl Classes="page" Classes.active="{Binding IsOpsActive}" IsVisible="{Binding IsOpsActive}" Content="{Binding OpsTab}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:OpsTabViewModel"><views:OpsTabView /></DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <ContentControl Classes="page" Classes.active="{Binding IsAorsActive}" IsVisible="{Binding IsAorsActive}" Content="{Binding AorTab}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:AorTabViewModel"><views:AorTabView /></DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <ContentControl Classes="page" Classes.active="{Binding IsReportActive}" IsVisible="{Binding IsReportActive}" Content="{Binding ReportTab}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:ReportTabViewModel"><views:ReportTabView /></DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <ContentControl Classes="page" Classes.active="{Binding IsLookupActive}" IsVisible="{Binding IsLookupActive}" Content="{Binding LookupTab}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:LookupTabViewModel"><views:LookupTabView /></DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <ContentControl Classes="page" Classes.active="{Binding IsSavedActive}" IsVisible="{Binding IsSavedActive}" Content="{Binding SavedTab}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="vm:SavedTabViewModel"><views:SavedTabView /></DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>

                        <!-- Notifications: over the sidebar only (a native web view can't be drawn over). -->
                        <ItemsControl ItemsSource="{Binding Toasts.Toasts}" VerticalAlignment="Top" Margin="6,6,6,0"
                                      AutomationProperties.LiveSetting="Polite">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToastViewModel">
                                    <Border Classes="toast" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Panel VerticalAlignment="Top" Margin="0,1,0,0">
                                                <controls:LunaIcon Classes="success" Data="{StaticResource IconCircleCheck}" IsVisible="{Binding IsSuccess}" />
                                                <controls:LunaIcon Classes="info" Data="{StaticResource IconInfo}" IsVisible="{Binding IsInfo}" />
                                                <controls:LunaIcon Classes="warning" Data="{StaticResource IconAlert}" IsVisible="{Binding IsWarning}" />
                                                <controls:LunaIcon Classes="danger" Data="{StaticResource IconCircleX}" IsVisible="{Binding IsError}" />
                                            </Panel>
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Classes="body" TextWrapping="Wrap" VerticalAlignment="Center"
                                                       AutomationProperties.Name="{Binding KindLabel}" />
                                            <Button Grid.Column="2" Classes="icon compact ghost" Tag="{Binding}" Click="DismissToast_Click"
                                                    AutomationProperties.Name="Dismiss notification" VerticalAlignment="Top">
                                                <controls:LunaIcon Classes="small" Data="{StaticResource IconX}" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </Border>

                <!-- Map: edge-to-edge (a native web view can't be clipped to rounded corners). -->
                <Border Grid.Column="2" Margin="12,0,0,0" BorderBrush="{DynamicResource LunaHairlineBrush}" BorderThickness="1,0,0,0">
                    <views:MapView Name="Map" />
                </Border>
            </Grid>
        </Grid>
    </Panel>
</Window>
