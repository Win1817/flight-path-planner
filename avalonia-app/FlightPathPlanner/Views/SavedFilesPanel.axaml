<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlightPathPlanner.ViewModels"
             x:Class="FlightPathPlanner.Views.SavedFilesPanel"
             x:DataType="vm:SavedFilesViewModel">

  <Border Background="#121726" BorderBrush="#232a3a" BorderThickness="1" CornerRadius="8" Padding="8"
          IsVisible="{Binding IsAvailable}">
    <StackPanel Spacing="8">

      <Button Command="{Binding ToggleExpandedCommand}" Background="Transparent" BorderThickness="0"
              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="4,2">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="{Binding ExpandGlyph}" Foreground="#9aa4b8" />
          <TextBlock Text="{Binding HeaderText}" FontWeight="SemiBold" FontSize="12" />
        </StackPanel>
      </Button>

      <StackPanel Spacing="8" IsVisible="{Binding IsExpanded}">

        <TextBlock Text="{Binding StatusMessage}" Foreground="#f87171" FontSize="11" TextWrapping="Wrap"
                   IsVisible="{Binding HasStatus}" />

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <Button Grid.Column="0" Content="{Binding ArchiveToggleText}" Command="{Binding ToggleArchiveViewCommand}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,4" />
          <Button Grid.Column="1" Content="Select all" Command="{Binding SelectAllCommand}"
                  IsVisible="{Binding HasRows}" Padding="8,4" />
        </Grid>

        <StackPanel Spacing="6" IsVisible="{Binding HasSelection}">
          <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
            <Button Grid.Column="0" Content="{Binding ArchiveSelectedText}" Command="{Binding ArchiveSelectedCommand}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,4" />
            <Button Grid.Column="1" Content="{Binding DeleteSelectedText}" Command="{Binding DeleteSelectedCommand}"
                    Background="#7f1d1d" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,4" />
          </Grid>
          <Button Content="Cancel" Command="{Binding CancelBulkDeleteCommand}" IsVisible="{Binding ConfirmingBulkDelete}"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="8,4" />
        </StackPanel>

        <TextBlock Text="{Binding EmptyText}" Foreground="#6b7488" FontSize="11" TextWrapping="Wrap"
                   HorizontalAlignment="Center" IsVisible="{Binding HasNoRows}" />

        <ScrollViewer MaxHeight="230" IsVisible="{Binding HasRows}" Padding="0,0,10,0">
          <ItemsControl ItemsSource="{Binding Rows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SavedFileRowViewModel">
                <Border Background="#151a28" BorderBrush="#232a3a" BorderThickness="1" CornerRadius="6"
                        Padding="8" Margin="0,0,0,6">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                      <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" />
                      <StackPanel Grid.Column="1" Spacing="1">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding MetaDisplay}" FontSize="10" Foreground="#6b7488" />
                      </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="Load" Tag="{Binding}" Click="Load_Click" IsVisible="{Binding CanLoad}" Padding="8,3" />
                      <Button Content="{Binding ArchiveButtonText}" Tag="{Binding}" Click="ToggleArchive_Click" Padding="8,3" />
                      <Button Content="{Binding DeleteButtonText}" Tag="{Binding}" Click="Delete_Click" Padding="8,3" Background="#3a1a1a" />
                      <Button Content="Cancel" Tag="{Binding}" Click="CancelDelete_Click" Padding="8,3"
                              IsVisible="{Binding ConfirmingDelete}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </StackPanel>
    </StackPanel>
  </Border>

</UserControl>
