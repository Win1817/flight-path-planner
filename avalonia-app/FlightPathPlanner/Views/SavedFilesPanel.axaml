<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FlightPathPlanner.ViewModels"
             xmlns:controls="using:FlightPathPlanner.Controls"
             x:Class="FlightPathPlanner.Views.SavedFilesPanel"
             x:DataType="vm:SavedFilesViewModel">

  <Border Classes="card" Padding="12" IsVisible="{Binding IsAvailable}">
    <StackPanel Spacing="10">

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <Button Classes="ghost" Command="{Binding ToggleExpandedCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Padding="6,0" AutomationProperties.Name="Show or hide this list">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <controls:LunaIcon Classes="small" Data="{StaticResource IconChevronDown}" IsVisible="{Binding IsExpanded}" />
            <controls:LunaIcon Classes="small" Data="{StaticResource IconChevronRight}" IsVisible="{Binding !IsExpanded}" />
            <TextBlock Text="{Binding HeaderText}" Classes="cardtitle" Foreground="{DynamicResource LunaTextBrush}" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="small" Command="{Binding ToggleArchiveViewCommand}" IsVisible="{Binding IsExpanded}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <controls:LunaIcon Classes="small" Data="{StaticResource IconArchive}" />
            <TextBlock Text="{Binding ArchiveToggleText}" />
          </StackPanel>
        </Button>
      </Grid>

      <StackPanel Spacing="10" IsVisible="{Binding IsExpanded}">

        <Border Classes="pill danger" HorizontalAlignment="Left" IsVisible="{Binding HasStatus}">
          <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
        </Border>

        <!-- Bulk actions -->
        <Border Classes="card quiet" IsVisible="{Binding HasSelection}">
          <StackPanel Spacing="8">
            <TextBlock Classes="secondary" VerticalAlignment="Center">
              <Run Text="{Binding SelectedCount}" /><Run Text=" selected" />
            </TextBlock>
            <TextBlock Text="{Binding ConfirmBulkDeleteText}" Classes="error" IsVisible="{Binding ConfirmingBulkDelete}" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <Button Content="{Binding ArchiveSelectedText}" Command="{Binding ArchiveSelectedCommand}" HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Classes="danger" Content="{Binding DeleteSelectedText}" Command="{Binding DeleteSelectedCommand}"
                      HorizontalAlignment="Stretch" />
            </Grid>
            <Button Content="Cancel" Classes="ghost" Command="{Binding CancelBulkDeleteCommand}" IsVisible="{Binding ConfirmingBulkDelete}"
                    HorizontalAlignment="Stretch" />
          </StackPanel>
        </Border>

        <Button Content="Select all" Classes="ghost small" Command="{Binding SelectAllCommand}" HorizontalAlignment="Left"
                IsVisible="{Binding HasRows}" />

        <StackPanel Spacing="6" HorizontalAlignment="Center" Margin="0,8" IsVisible="{Binding HasNoRows}">
          <controls:LunaIcon Classes="large" Data="{StaticResource IconFolder}" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding EmptyText}" Classes="secondary" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="240" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Rows}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SavedFileRowViewModel">
              <Border Classes="card quiet" Classes.selected="{Binding IsSelected}" Margin="0,0,0,8">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" MinWidth="0" AutomationProperties.Name="Select file" />
                    <Border Grid.Column="1" Width="34" Height="34" CornerRadius="10" Background="{DynamicResource LunaAccentTintBrush}">
                      <controls:LunaIcon Classes="accent" Data="{StaticResource IconFile}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding DisplayName}" Classes="cardtitle" ToolTip.Tip="{Binding DisplayName}" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding MetaDisplay}" Classes="meta" />
                        <Border Classes="pill" Padding="6,0" IsVisible="{Binding IsArchived}"><TextBlock Text="Archived" /></Border>
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button Classes="icon compact" Tag="{Binding}" Click="Load_Click" IsVisible="{Binding CanLoad}"
                            AutomationProperties.Name="Reload this file" ToolTip.Tip="Reload into its tab">
                      <controls:LunaIcon Data="{StaticResource IconOpen}" />
                    </Button>
                    <Button Classes="icon compact" Tag="{Binding}" Click="ToggleArchive_Click" IsVisible="{Binding !IsArchived}"
                            AutomationProperties.Name="Archive this file" ToolTip.Tip="Archive">
                      <controls:LunaIcon Data="{StaticResource IconArchive}" />
                    </Button>
                    <Button Classes="icon compact" Tag="{Binding}" Click="ToggleArchive_Click" IsVisible="{Binding IsArchived}"
                            AutomationProperties.Name="Restore this file" ToolTip.Tip="Restore">
                      <controls:LunaIcon Data="{StaticResource IconRestore}" />
                    </Button>
                    <Button Classes="icon compact danger" Tag="{Binding}" Click="Delete_Click" IsVisible="{Binding !ConfirmingDelete}"
                            AutomationProperties.Name="Delete this file" ToolTip.Tip="Delete permanently">
                      <controls:LunaIcon Data="{StaticResource IconTrash}" />
                    </Button>
                    <Button Classes="danger small" Content="Delete permanently" Tag="{Binding}" Click="Delete_Click" IsVisible="{Binding ConfirmingDelete}" />
                    <Button Classes="small" Content="Cancel" Tag="{Binding}" Click="CancelDelete_Click" IsVisible="{Binding ConfirmingDelete}" />
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
    </StackPanel>
  </Border>

</UserControl>
