<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FlightPathPlanner.App"
             xmlns:local="using:FlightPathPlanner"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://FlightPathPlanner/Styles/LunaTokens.axaml" />
                <ResourceInclude Source="avares://FlightPathPlanner/Styles/LunaIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <!-- Recolours Fluent's accent (checkboxes, focus, selection) to Luna purple. -->
                <ColorPaletteResources x:Key="Dark" Accent="#8B5CF6" RegionColor="#0B0A12" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://FlightPathPlanner/Styles/LunaStyles.axaml" />
    </Application.Styles>
</Application>
