<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============ Luna colour palette ============ -->
  <Color x:Key="LunaPurple">#8B5CF6</Color>
  <Color x:Key="LunaViolet">#A78BFA</Color>
  <Color x:Key="LunaIndigo">#6366F1</Color>
  <Color x:Key="LunaLavender">#C4B5FD</Color>
  <Color x:Key="LunaBackground">#0B0A12</Color>
  <Color x:Key="LunaSurface">#13111C</Color>
  <Color x:Key="LunaSurface2">#1B1826</Color>
  <Color x:Key="LunaBorder">#2A2638</Color>
  <Color x:Key="LunaText">#F8F7FF</Color>
  <Color x:Key="LunaSecondary">#A9A5B8</Color>
  <!-- Slightly dimmer than Secondary for metadata; still ~5:1 on Surface. -->
  <Color x:Key="LunaTertiary">#8A8699</Color>
  <Color x:Key="LunaSuccess">#34D399</Color>
  <Color x:Key="LunaWarning">#FBBF24</Color>
  <Color x:Key="LunaDanger">#FB7185</Color>
  <Color x:Key="LunaInfo">#60A5FA</Color>

  <SolidColorBrush x:Key="LunaPurpleBrush" Color="{StaticResource LunaPurple}" />
  <SolidColorBrush x:Key="LunaVioletBrush" Color="{StaticResource LunaViolet}" />
  <SolidColorBrush x:Key="LunaIndigoBrush" Color="{StaticResource LunaIndigo}" />
  <SolidColorBrush x:Key="LunaLavenderBrush" Color="{StaticResource LunaLavender}" />
  <SolidColorBrush x:Key="LunaBackgroundBrush" Color="{StaticResource LunaBackground}" />
  <SolidColorBrush x:Key="LunaSurfaceBrush" Color="{StaticResource LunaSurface}" />
  <SolidColorBrush x:Key="LunaSurface2Brush" Color="{StaticResource LunaSurface2}" />
  <SolidColorBrush x:Key="LunaBorderBrush" Color="{StaticResource LunaBorder}" />
  <SolidColorBrush x:Key="LunaTextBrush" Color="{StaticResource LunaText}" />
  <SolidColorBrush x:Key="LunaSecondaryBrush" Color="{StaticResource LunaSecondary}" />
  <SolidColorBrush x:Key="LunaTertiaryBrush" Color="{StaticResource LunaTertiary}" />
  <SolidColorBrush x:Key="LunaSuccessBrush" Color="{StaticResource LunaSuccess}" />
  <SolidColorBrush x:Key="LunaWarningBrush" Color="{StaticResource LunaWarning}" />
  <SolidColorBrush x:Key="LunaDangerBrush" Color="{StaticResource LunaDanger}" />
  <SolidColorBrush x:Key="LunaInfoBrush" Color="{StaticResource LunaInfo}" />

  <!-- ============ Surfaces (glass = translucent tint over the backdrop) ============ -->
  <SolidColorBrush x:Key="LunaGlassBrush" Color="#B313111C" />
  <SolidColorBrush x:Key="LunaGlassStrongBrush" Color="#E013111C" />
  <SolidColorBrush x:Key="LunaCardBrush" Color="#991B1826" />
  <SolidColorBrush x:Key="LunaCardHoverBrush" Color="#CC221E30" />
  <SolidColorBrush x:Key="LunaInputBrush" Color="#CC0F0D17" />
  <SolidColorBrush x:Key="LunaGlassBorderBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="LunaHairlineBrush" Color="#14FFFFFF" />
  <SolidColorBrush x:Key="LunaAccentBorderBrush" Color="#998B5CF6" />
  <SolidColorBrush x:Key="LunaAccentTintBrush" Color="#248B5CF6" />

  <!-- ============ Gradients ============ -->
  <LinearGradientBrush x:Key="LunaAccentGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#8B5CF6" Offset="0" />
    <GradientStop Color="#6366F1" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LunaAccentGradientHover" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#9D75F8" Offset="0" />
    <GradientStop Color="#7B7EF3" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LunaAccentGradientPressed" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#7444E0" Offset="0" />
    <GradientStop Color="#5254D8" Offset="1" />
  </LinearGradientBrush>
  <!-- Subtle tint for the active navigation pill and selected controls. -->
  <LinearGradientBrush x:Key="LunaAccentSoftGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#408B5CF6" Offset="0" />
    <GradientStop Color="#286366F1" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="LunaTextGradient" StartPoint="0%,0%" EndPoint="100%,100%">
    <GradientStop Color="#C4B5FD" Offset="0" />
    <GradientStop Color="#8B9BFF" Offset="1" />
  </LinearGradientBrush>

  <!-- Very quiet radial glows behind everything. -->
  <RadialGradientBrush x:Key="LunaGlowTopLeft" Center="10%,0%" RadiusX="70%" RadiusY="70%">
    <GradientStop Color="#268B5CF6" Offset="0" />
    <GradientStop Color="#008B5CF6" Offset="1" />
  </RadialGradientBrush>
  <RadialGradientBrush x:Key="LunaGlowBottomRight" Center="95%,100%" RadiusX="60%" RadiusY="60%">
    <GradientStop Color="#1E6366F1" Offset="0" />
    <GradientStop Color="#006366F1" Offset="1" />
  </RadialGradientBrush>

  <!-- ============ Shadows ============ -->
  <BoxShadows x:Key="LunaShadowCard">0 4 16 0 #33000000</BoxShadows>
  <BoxShadows x:Key="LunaShadowGlass">0 12 40 0 #66000000</BoxShadows>
  <BoxShadows x:Key="LunaShadowRaised">0 8 24 0 #55000000</BoxShadows>
  <BoxShadows x:Key="LunaGlowSelected">0 0 0 1 #558B5CF6, 0 6 24 0 #338B5CF6</BoxShadows>
  <BoxShadows x:Key="LunaGlowButton">0 4 16 0 #448B5CF6</BoxShadows>

  <!-- ============ Spacing (4-pt scale) ============ -->
  <x:Double x:Key="LunaSpace1">4</x:Double>
  <x:Double x:Key="LunaSpace2">8</x:Double>
  <x:Double x:Key="LunaSpace3">12</x:Double>
  <x:Double x:Key="LunaSpace4">16</x:Double>
  <x:Double x:Key="LunaSpace5">20</x:Double>
  <x:Double x:Key="LunaSpace6">24</x:Double>
  <x:Double x:Key="LunaSpace8">32</x:Double>

  <!-- ============ Corner radius ============ -->
  <CornerRadius x:Key="LunaRadiusSm">8</CornerRadius>
  <CornerRadius x:Key="LunaRadiusMd">12</CornerRadius>
  <CornerRadius x:Key="LunaRadiusLg">16</CornerRadius>
  <CornerRadius x:Key="LunaRadiusXl">20</CornerRadius>
  <CornerRadius x:Key="LunaRadiusXxl">24</CornerRadius>
  <CornerRadius x:Key="LunaRadiusPill">999</CornerRadius>

  <!-- ============ Control heights ============ -->
  <x:Double x:Key="LunaControlHeightXs">32</x:Double>
  <x:Double x:Key="LunaControlHeightSm">36</x:Double>
  <x:Double x:Key="LunaControlHeightMd">40</x:Double>
  <x:Double x:Key="LunaControlHeightLg">44</x:Double>
  <x:Double x:Key="LunaControlHeightXl">48</x:Double>

  <!-- ============ Opacity steps ============ -->
  <x:Double x:Key="LunaOpacity04">0.04</x:Double>
  <x:Double x:Key="LunaOpacity08">0.08</x:Double>
  <x:Double x:Key="LunaOpacity12">0.12</x:Double>
  <x:Double x:Key="LunaOpacity18">0.18</x:Double>
  <x:Double x:Key="LunaOpacity24">0.24</x:Double>

  <!-- ============ Typography ============ -->
  <x:Double x:Key="LunaFontPageTitle">26</x:Double>
  <x:Double x:Key="LunaFontSectionTitle">18</x:Double>
  <x:Double x:Key="LunaFontCardTitle">14</x:Double>
  <x:Double x:Key="LunaFontBody">13</x:Double>
  <x:Double x:Key="LunaFontSecondary">12</x:Double>
  <x:Double x:Key="LunaFontMeta">11</x:Double>

  <!-- ============ Motion ============ -->
  <x:TimeSpan x:Key="LunaDurationFast">0:0:0.12</x:TimeSpan>
  <x:TimeSpan x:Key="LunaDurationBase">0:0:0.18</x:TimeSpan>

  <!-- ============ Fluent control overrides (named theme resources) ============ -->
  <SolidColorBrush x:Key="DatePickerButtonBackground" Color="#CC0F0D17" />
  <SolidColorBrush x:Key="DatePickerButtonBackgroundPointerOver" Color="#CC17141F" />
  <SolidColorBrush x:Key="DatePickerButtonBackgroundPressed" Color="#CC0F0D17" />
  <SolidColorBrush x:Key="DatePickerButtonBorderBrush" Color="#1FFFFFFF" />
  <SolidColorBrush x:Key="DatePickerButtonBorderBrushPointerOver" Color="#338B5CF6" />
  <SolidColorBrush x:Key="DatePickerButtonBorderBrushPressed" Color="#998B5CF6" />
  <SolidColorBrush x:Key="DatePickerButtonForeground" Color="#F8F7FF" />
  <SolidColorBrush x:Key="DatePickerButtonForegroundPointerOver" Color="#F8F7FF" />
  <SolidColorBrush x:Key="DatePickerButtonForegroundPressed" Color="#F8F7FF" />
  <x:Double x:Key="DatePickerThemeMinWidth">0</x:Double>
  <SolidColorBrush x:Key="DatePickerFlyoutPresenterBackground" Color="#F21B1826" />
  <SolidColorBrush x:Key="DatePickerFlyoutPresenterBorderBrush" Color="#2A2638" />
  <SolidColorBrush x:Key="DatePickerFlyoutPresenterHighlightFill" Color="#338B5CF6" />
</ResourceDictionary>
